    function convertToPython() {
        let jsCode = document.getElementById('inputJs').value;
        let pythonCode = '';
        let indentLevel = 0;
        const indentSpace = '    '; // 4 spaces

        // --- PHASE 1: Pre-processing and Global Replacements ---

        // NEW: 1. Convert multi-line JS comments to Python docstrings,
        // ensuring any text on the same line as /* is moved underneath it.
        // It looks for /* and replaces it with """\n (forcing a new line) and 
        // replaces */ with \n"""
        jsCode = jsCode.replace(/\/\*([\s\S]*?)\*\//g, (match, content) => {
            // Check if the comment starts on the same line as code (before /*)
            const precedingCode = jsCode.substring(0, jsCode.indexOf(match)).match(/[^\s]\s*$/);
            const prefix = precedingCode ? '\n' : ''; // Add newline if preceded by non-whitespace

            // Convert content, ensuring it's wrapped cleanly
            return prefix + '"""\n' + content.trim() + '\n"""';
        });

        // NEW: 2. Specific fix for single-line comments without a space: //nospacecomment -> # nospacecomment
        // This must run before the general single-line comment conversion.
        jsCode = jsCode.replace(/\/\/(?![\s/])(?!https?:\/\/)(.*)/g, '# $1');


        // 3. Pre-process to handle template literals (f-strings)
        // Basic attempt: `text ${var} text` -> f"text {var} text"
        jsCode = jsCode.replace(/`([^`]*)`/g, (match, content) => {
            return 'f"' + content.replace(/\${(.*?)}/g, '{$1}') + '"';
        });

        // 4. Simple keyword and operator replacements
        jsCode = jsCode
            .replace(/\/\/(?!https?:\/\/)(.*)/g, '#$1') // General single line comments (avoiding URLs)
            .replace(/\b(var|let|const)\s+/g, '') // Remove JS declarations
            // Capitalize keywords (True, False, None)
            .replace(/\b(false|null|true)\b/g, (match) => match.charAt(0).toUpperCase() + match.slice(1)) 
            .replace(/\bfunction\b/g, 'def')
            .replace(/===/g, '==') 
            .replace(/!==/g, '!=') 
            .replace(/&&/g, 'and')
            .replace(/\|\|/g, 'or')
            .replace(/\belse\s+if\b/g, 'elif'); // Must be done before indentation loop for proper colon placement

        // NEW: 5. More Conversions for improved translation
        jsCode = jsCode
            // Console, IO, and Built-ins
            .replace(/\bconsole\.(log|error|warn)\s*\((.*)\)/g, 'print($2)')
            .replace(/\bprompt\s*\((.*)\)/g, 'input($1)')
            .replace(/\bparseFloat\s*\((.*)\)/g, 'float($1)')
            .replace(/\bparseInt\s*\((.*)\)/g, 'int($1)')
            // Array/String methods
            .replace(/\.push\s*\((.*)\)/g, '.append($1)')
            .replace(/\.pop\s*\(\)/g, '.pop()')
            .replace(/\.shift\s*\(\)/g, '.pop(0)')
            .replace(/\.unshift\s*\((.*)\)/g, '.insert(0, $1)')
            .replace(/\.toUpperCase\s*\(\)/g, '.upper()')
            .replace(/\.toLowerCase\s*\(\)/g, '.lower()')
            .replace(/\b(new\s+Array\s*\()(\s*)\)/g, '[]') // new Array() -> []
            .replace(/\b(\w+)\.toFixed\s*\((.*)\)/g, 'round($1, $2)') // number.toFixed(2) -> round(number, 2)
            // Operators and Types
            .replace(/\btypeof\s+([^\s]+)/g, 'type($1)') // typeof x -> type(x)
            .replace(/\b(\w+)\s+in\s+([^\s]+)/g, '$1 in $2') // 'key' in object -> 'key' in object.keys() (requires manual refinement by user, but this is a start)

            // Math functions (requires import math/random)
            .replace(/\bMath\.PI\b/g, 'math.pi')
            .replace(/\bMath\.pow\s*\((.*),\s*(.*)\)/g, 'math.pow($1, $2)') // Use math.pow
            .replace(/\bMath\.random\s*\(\)/g, 'random.random()')
            // Remove semicolon at end of line (this is safe to do globally)
            .replace(/;\s*$/gm, '');


        // --- PHASE 2: Line-by-Line Indentation and Block Logic ---

        const lines = jsCode.split('\n');
        let requiresMath = false;
        let requiresRandom = false;
        let needsObjectKeysHint = false;

        for (const line of lines) {
            let processedLine = line.trim();

            // Check for required imports (after replacements)
            if (processedLine.includes('math.')) {
                requiresMath = true;
            }
            if (processedLine.includes('random.random()')) {
                requiresRandom = true;
            }
            if (processedLine.includes(' in ')) {
                // If 'in' is used, Python expects dict keys() or a list/tuple. 
                // JS 'in' on objects checks keys, so we flag for a hint.
                needsObjectKeysHint = true;
            }
            
            // 1. Handle closing block '}' - DECREMENT INDENTATION FIRST
            if (processedLine.endsWith('}')) {
                indentLevel = Math.max(0, indentLevel - 1);
                processedLine = processedLine.slice(0, -1).trim();
            }
            if (processedLine.startsWith('}')) {
                // This covers } else { blocks after splitting
                indentLevel = Math.max(0, indentLevel - 1);
                processedLine = processedLine.slice(1).trim();
            }

            // Skip empty lines (after trim/brace removal)
            if (processedLine === '') continue;

            // Apply current indentation
            let outputLine = indentSpace.repeat(indentLevel) + processedLine;
            
            // Final cleanup: array.length to len(array)
            outputLine = outputLine.replace(/(\w+)\.length/g, 'len($1)');


            // 2. Handle opening block '{' and add ':' - INCREMENT INDENTATION LAST
            if (outputLine.trim().endsWith('{')) {
                // Remove the brace
                outputLine = outputLine.slice(0, -1).trimEnd();

                // Check if it's a block starter and needs a colon
                const blockStarterRegex = /\b(if|else|elif|for|while|def|class|try|except|finally)\b/;

                if (outputLine.match(blockStarterRegex) && !outputLine.endsWith(':')) {
                    outputLine += ':';
                }

                // Increase indent level for next line
                indentLevel++;

            } else {
                // Case where the statement ends without a brace, but should be a block starter
                const blockStarterRegex = /\b(if|else|elif|for|while|def|class|try|except|finally)\b/;
                // Note: We use outputLine.trim() in match to ensure we catch 'else' or 'finally' even if indented
                if (outputLine.trim().match(blockStarterRegex) && !outputLine.endsWith(':')) {
                    outputLine += ':';
                    indentLevel++;
                }
            }
            
            // Final sanity check for colon placement on keywords
            outputLine = outputLine.replace(/\breturn\s*:/g, 'return');
            outputLine = outputLine.replace(/\bbreak\s*:/g, 'break');
            outputLine = outputLine.replace(/\bcontinue\s*:/g, 'continue');

            pythonCode += outputLine + '\n';
        }

        // --- PHASE 3: Prepend Imports and Cleanup ---
        let imports = [];
        if (requiresMath) {
            imports.push('import math');
        }
        if (requiresRandom) {
            imports.push('import random');
        }
        if (needsObjectKeysHint) {
            // Provide a comment to guide the user on key checking
            imports.push('# NOTE: JS "key in object" behavior usually requires using .keys() in Python:');
            imports.push('# e.g., "key" in my_object.keys()');
        }


        if (imports.length > 0) {
            pythonCode = imports.join('\n') + '\n\n' + pythonCode;
        }

        // Clean up any double empty lines and extra whitespace
        pythonCode = pythonCode.replace(/\n\s*\n/g, '\n\n').trim();

        document.getElementById('output').textContent = pythonCode;
    }
